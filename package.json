{
  "name": "steam-client",
  "version": "1.0.0",
  "description": "Custom Steam-like desktop client built with Electron + React + SQLite",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "dev": "electron .",
    "vite": "vite",
    "vite:build": "vite build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "better-sqlite3": "^9.4.3",
    "zustand": "^4.5.1",
    "electron-store": "^8.1.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0",
    "framer-motion": "^11.0.0",
    "react-icons": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.steamclient.app",
    "productName": "Steam Client",
    "files": [
      "main.js",
      "preload.js",
      "src/db.js",
      "src/ipc-handlers.js",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
